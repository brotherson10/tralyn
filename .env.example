# -----------------------------------------------------------------------------
# Tralyn — environment variables (example only; never commit real values)
# -----------------------------------------------------------------------------

# =============================================================================
# 1. Web application — local development
# Copy this file to .env.local (git-ignored). For the local Supabase stack,
# both values are printed by `npm run db:status` ("API URL" and the
# publishable key).
# =============================================================================

# Supabase API URL. Local stack: http://127.0.0.1:54321
# Hosted project: https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Public client key: the "publishable" key (sb_publishable_...) or, on projects
# that still use legacy keys, the "anon" key. It is safe in the browser: it
# only grants what Row Level Security allows.
# (NEXT_PUBLIC_SUPABASE_ANON_KEY is also accepted as an alternative name.)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# =============================================================================
# 2. Local import CLI (optional) — `npm run inventory:import:local`
# Loopback PostgreSQL only; any other host is refused. Not needed by
# `npm run demo:setup`, which reads the local stack from `supabase status`.
# =============================================================================

# INVENTORY_IMPORT_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# =============================================================================
# 3. Hosted administration — SERVER-ONLY, NOT for local development
# Used only by the hosted tooling in scripts/ (technical identity check and
# provisioning, hosted import dry-run and apply), run manually from a trusted
# machine. Keep these OUT of .env.local: put them in a separate git-ignored
# file and pass it explicitly (`npx tsx --env-file=<file> scripts/...`).
# Never prefix them with NEXT_PUBLIC_ and never set them in the deployment.
# `npm run demo:setup` refuses to run while any of them is set.
# =============================================================================

# Ref of the ONLY hosted project the tooling may touch (required, no default).
# SUPABASE_PROJECT_REF=

# Secret key (sb_secret_...) or legacy "service_role" key. Bypasses RLS.
# Used only by scripts/hosted-import-identity.ts.
# SUPABASE_SERVICE_ROLE_KEY=

# Direct or session-pooler connection string of the hosted project, and the
# path to its CA certificate (Database Settings → SSL) for verify-full TLS.
# INVENTORY_HOSTED_DATABASE_URL=
# INVENTORY_HOSTED_DATABASE_CA_FILE=
