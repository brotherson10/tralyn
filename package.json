{
  "name": "tralyn",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:types": "supabase gen types typescript --local --schema public > src/types/database.ts",
    "db:reset": "supabase db reset --local",
    "db:lint": "supabase db lint --local --level warning",
    "test:db": "vitest run -c vitest.db.config.mts",
    "test:demo": "vitest run -c vitest.demo.config.mts",
    "db:types:remote": "supabase gen types typescript --linked --schema public > src/types/database.ts",
    "test:e2e": "playwright test",
    "identity:provision:local": "tsx scripts/provision-import-identity.ts",
    "identity:hosted:check": "tsx scripts/hosted-import-identity.ts check",
    "inventory:parse": "tsx scripts/inventory-parse.ts",
    "inventory:demo-workbook": "tsx scripts/inventory-demo-workbook.ts",
    "demo:setup": "tsx scripts/demo-setup.ts",
    "inventory:import:local": "tsx scripts/inventory-import-local.ts",
    "inventory:import:hosted:dry-run": "tsx scripts/inventory-import-hosted-dry-run.ts",
    "inventory:import:hosted:apply": "tsx scripts/inventory-import-hosted-apply.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.19.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "pg": "^8.23.0",
    "supabase": "^2.118.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.2",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  }
}
